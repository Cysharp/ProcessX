<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProcessX\ProcessX.csproj" />
    <!-- referenced as a library so the analyzer tests can instantiate it, and as an analyzer so it runs on the tests themselves -->
    <ProjectReference Include="..\..\src\ProcessX.Analyzer\ProcessX.Analyzer.csproj" ReferenceOutputAssembly="true" OutputItemType="Analyzer" />
    <!-- child process for the tests; its dll is copied next to the test assembly -->
    <ProjectReference Include="..\ProcessX.Tests.Helper\ProcessX.Tests.Helper.csproj" />
  </ItemGroup>

</Project>
